# Variáveis de ambiente - COPIE este arquivo para .env e preencha os valores
# NÃO use valores reais aqui

# Porta em que o servidor escuta (apenas 127.0.0.1)
PORT=3000

# Ambiente: development ou production
NODE_ENV=development

# Segredo da sessão - mínimo 32 caracteres, use um valor aleatório e seguro
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=coloque-aqui-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Caminho do banco de dados SQLite (opcional, padrão: data/app.db)
# DATABASE_PATH=./data/app.db

